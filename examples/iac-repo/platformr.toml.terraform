# acme-corp/terraform-infra/platformr.toml
#
# Terraform resources. Target paths and templates are different from Crossplane
# but the model is identical — platformr doesn't care which executor runs the IaC.

[defaults]
target_path   = "environments/{{.resource}}/"
template_path = "platformr/templates/{{.resource}}.tfvars.tmpl"
base_branch   = "main"

[[resources]]
name        = "database"
description = "Request a new RDS database"
pr_title    = "feat(db): add {{.name}}"

  # "project" lives in a different repo (acme-corp/platform-claims), and dirs:/
  # files: sources only ever list within THIS repo — so there's no dynamic
  # picker here. Type the project name that was used there; platformr doesn't
  # verify it's real.
  [[resources.fields]]
  name        = "project"
  type        = "input"
  label       = "Project name (from platform-claims)"
  placeholder = "payments"

  [[resources.fields]]
  name        = "name"
  type        = "input"
  label       = "Database name"
  placeholder = "payments-primary"
  validate    = "unique"

  [[resources.fields]]
  name    = "engine"
  type    = "select"
  label   = "Engine"
  options = ["postgres", "mysql"]

  [[resources.fields]]
  name    = "environment"
  type    = "select"
  label   = "Environment"
  options = ["dev", "staging", "prod"]

[[resources]]
name        = "vpc"
description = "Request a new VPC"
pr_title    = "feat(vpc): add {{.name}}"

  [[resources.fields]]
  name        = "name"
  type        = "input"
  label       = "VPC name"
  placeholder = "prod-us-east-1"
  validate    = "unique"

  [[resources.fields]]
  name    = "cidr"
  type    = "input"
  label   = "CIDR block"
  default = "10.0.0.0/16"
