----- values.yaml -----
# Owned by people
replicaCount: 4   # how many
image:
  repository: ghcr.io/acme/payments
  tag: "1.5.0"
resources:
  requests:
    cpu: "1"
    memory: '1Gi'
env:
  - name: LOG_LEVEL
    value: info
  - name: REGION
    value: us-east-1
tolerations: [gpu]
ports: [443, 8080]
